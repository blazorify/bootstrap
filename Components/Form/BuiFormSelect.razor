@namespace Blazorify.Bootstrap
@inherits BuiInputComponentBase<T>
@typeparam T

<CascadingValue Name="Parent" Value="this">
	<select class="form-select @ClassList" style="@Style" id="@ID" name="@Name" disabled="@Disabled" @onchange="(async (args) => await HandleChange(args))">
		@if (ChildContent != null)
		{
			@ChildContent
		}
		else
		{
			@foreach (var kvp in itemsMap) {
				<BuiFormOption Value="@kvp.Key">
					@Label.Invoke(kvp.Value)
				</BuiFormOption>
			}
		}
	</select>
</CascadingValue>
