@namespace Blazorify.Bootstrap
@inherits BuiInputComponentBase<T>
@typeparam T

<option @key="Item" value="@(OptionValue != null ? OptionValue.Invoke(Item) : Item)" selected="@(Selected || Item!.Equals(Value))" @onclick="HandleSelect">
	@(OptionLabel != null ? OptionLabel.Invoke(Item) : Item)
</option>
