@namespace Blazorify.Bootstrap
@inherits BuiInputComponentBase<String>

<textarea type="text"
		  class="form-control @ClassList"
		  id="@ID"
		  name="@Name"
		  placeholder="@Placeholder"
		  value="@Value"
		  autofocus="@AutoFocus"
		  @onchange="(async (args) => await HandleChange(args))"
		  @oninput="(async (args) => await HandleInput(args))"></textarea>
