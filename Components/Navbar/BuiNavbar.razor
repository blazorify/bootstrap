@namespace Blazorify.Bootstrap
@inherits BuiContentComponentBase

<nav class="navbar @ClassList" style="@Style">
	<BuiContainer Fluid="Fluid">
		@if (Brand != null) {
			<div class="navbar-brand">
				@Brand
			</div>
		}

		<BuiButton Type="ButtonType.Button" Class="navbar-toggler">
			<span class="navbar-toggler-icon"></span>
		</BuiButton>

		<div class="collapse navbar-collapse">
			@if (Nav != null) {
				@Nav
			} else {
				@ChildContent
			}
		</div>
	</BuiContainer>
</nav>
