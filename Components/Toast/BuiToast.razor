@namespace Blazorify.Bootstrap
@inherits BuiContentComponentBase

<div class="toast fade @ClassList" role="alert" aria-live="assertive" aria-atomic="true">
	@if (showHeader == true) {
		<div class="toast-header">
			@if (Icon != null) {
				<img class="rounded me-2" src="@Icon" />
			}

			@if (Title != null) {
				<strong class="me-auto">
					@Title
				</strong>
			}

			@if (Time != null) {
				<small>@Time</small>
			}

			@if (Dismissible == true) {
				<button type="button" class="btn-close" @onclick="HandleDismiss" aria-label="Close"></button>
			}
		</div>
	}

	<div class="d-flex">
		<div class="toast-body">
			@ChildContent
		</div>

		@if (showHeader == false && Dismissible == true) {
			<button type="button" class="btn-close me-2 m-auto" @onclick="HandleDismiss" aria-label="Close"></button>
		}
	</div>
</div>
