@namespace Blazorify.Bootstrap
@inherits BuiContentComponentBase

<div class="modal fade @ClassList" tabindex="-1" style="display: @(Shown ? "block" : "none");">
	<div class="modal-dialog @(Fullscreen ? "modal-fullscreen" : "")">
		<div class="modal-content">
			<CascadingValue Value="this">
				@ChildContent
			</CascadingValue>
		</div>
	</div>
</div>
