@namespace Blazorify.Bootstrap
@inherits BuiContentComponentBase

@if (!String.IsNullOrWhiteSpace(Href)) {
	<a class="list-group-item @ClassList" data-bs-theme="@ThemeAttribute" style="@Style" href="@Href">
		@ChildContent
	</a>
} else {
	<div class="list-group-item @ClassList" data-bs-theme="@ThemeAttribute" style="@Style">
		@ChildContent
	</div>
}
