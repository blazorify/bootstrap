@namespace Blazorify.Bootstrap
@inherits BuiContentComponentBase

<CascadingValue Value="this">
	@if (WithNav) {
		<nav class="nav @(Vertical ? "flex-column" : "")">
			@foreach (var tab in tabs) {
				<BuiNavItem Class="@tab.Class" Style="@tab.Style">
					<BuiNavLink Active="tab.Active" OnClick="@(async () => await SetActiveTab(tabs.IndexOf(tab)))">
						@tab.Header
					</BuiNavLink>
				</BuiNavItem>
			}
		</nav>
	}

	<nav class="tab-content @ClassList" style="@Style">
		@foreach (var tab in tabs) {
			<div class="tab-pane fade @tab.GetClassList()">
				@tab.ChildContent
			</div>
		}
	</nav>

	@ChildContent
</CascadingValue>
