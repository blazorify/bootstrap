@namespace Blazorify.Bootstrap
@inherits BuiMaskedInputComponentBase<T>
@typeparam T

<input type="text"
	   class="form-control @ClassList"
	   data-bs-theme="@ThemeAttribute"
	   style="@Style"
	   id="@ID"
	   name="@Name"
	   placeholder="@Placeholder"
	   value="@MaskedValue"
	   disabled="@Disabled"
	   autofocus="@AutoFocus"
	   @onchange="(async (args) => await HandleChange(args))"
	   @oninput="(async (args) => await HandleInput(args))" />
