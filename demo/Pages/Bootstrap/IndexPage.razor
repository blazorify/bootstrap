@page "/bootstrap"

<BuiRow>
	<BuiCol>
		<BuiText Tag="h1" Class="h1">
			Explore Blazorify Bootstrap
		</BuiText>

		<BuiText Class="lead">
			Discover our library and all components to power your next project
		</BuiText>
	</BuiCol>
</BuiRow>

<BuiRow Class="mt-4">
	<BuiCol>
		<BuiText Tag="h2" Class="h2">
			Layout
		</BuiText>
	</BuiCol>
</BuiRow>

<BuiRow Class="mt-3">
	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/layout/grid">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Grid
				</BuiCardTitle>

				<BuiCardText Class="small">
					Arrange content in a responsive layout.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>
</BuiRow>

<BuiRow Class="mt-4">
	<BuiCol>
		<BuiText Tag="h2" Class="h2">
			Components
		</BuiText>
	</BuiCol>
</BuiRow>

<BuiRow Class="mt-3">
	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/alerts">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Alerts
				</BuiCardTitle>

				<BuiCardText Class="small">
					Display contextual messages for user actions.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/badges">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Badges
				</BuiCardTitle>

				<BuiCardText Class="small">
					Add small labels for counters or highlights.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/breadcrumb">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Breadcrumb
				</BuiCardTitle>

				<BuiCardText Class="small">
					Indicate the current page location in navigation.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/buttons">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Buttons
				</BuiCardTitle>

				<BuiCardText Class="small">
					Trigger actions with customizable buttons.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/cards">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Cards
				</BuiCardTitle>

				<BuiCardText Class="small">
					Flexible containers for content and actions.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/carousel">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Carousel
				</BuiCardTitle>

				<BuiCardText Class="small">
					Create a slideshow of images or content.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/collapse">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Collapse
				</BuiCardTitle>

				<BuiCardText Class="small">
					Toggle visibility of content panels.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/dropdowns">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Dropdown
				</BuiCardTitle>

				<BuiCardText Class="small">
					Show menus or options in a toggleable list.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/list-group">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					List group
				</BuiCardTitle>

				<BuiCardText Class="small">
					Organize items in ordered or unordered lists.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/modal">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Modal
				</BuiCardTitle>

				<BuiCardText Class="small">
					Show overlays for dialogs or additional content.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/navbar">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Navbar
				</BuiCardTitle>

				<BuiCardText Class="small">
					Create responsive headers for site navigation.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/navs-tabs">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Navs & Tabs
				</BuiCardTitle>

				<BuiCardText Class="small">
					Organize content into switchable tabs.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/offcanvas">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Offcanvas
				</BuiCardTitle>

				<BuiCardText Class="small">
					Show hidden side panels for additional content.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>

	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/components/toasts">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Toasts
				</BuiCardTitle>

				<BuiCardText Class="small">
					Display brief notifications or updates.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>
</BuiRow>

<BuiRow Class="mt-4">
	<BuiCol>
		<BuiText Tag="h2" Class="h2">
			Forms
		</BuiText>
	</BuiCol>
</BuiRow>

<BuiRow Class="mt-3">
	<BuiCol Class="mb-3" XS="3">
		<BuiLink Class="card h-100" Decoration="TextDecoration.None" Href="/bootstrap/forms/inputs">
			<BuiImage Class="card-img-top mb-0" Source="https://placehold.it/450x300" />

			<BuiCardBody>
				<BuiCardTitle>
					Inputs
				</BuiCardTitle>

				<BuiCardText Class="small">
					Form controls like input and textarea.
				</BuiCardText>
			</BuiCardBody>
		</BuiLink>
	</BuiCol>
</BuiRow>
