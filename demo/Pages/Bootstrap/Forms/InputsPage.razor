@page "/bootstrap/forms/inputs"

<BuiContainer>
	<BuiRow>
		<BuiCol>
			<BuiText Tag="h1">
				Inputs
			</BuiText>

			<BuiText Class="lead">
				Give textual form controls like <code>&lt;input&gt;</code>s and <code>&lt;textarea&gt;</code>s
				an upgrade with custom styles, sizing, focus states, and more.
			</BuiText>
		</BuiCol>
	</BuiRow>

	<BuiRow>
		<BuiCol>
			<BuiText Tag="h2">
				Examples
			</BuiText>

			<BuiText>
				Alerts are available for any length of text, as well as an optional close button.
				For proper styling, use one of the eight <strong>required</strong> contextual classes
				(e.g., <code>.alert-success</code>). For inline dismissal,
				use the <a href="#dismissing">alerts JavaScript plugin</a>.
			</BuiText>

			@code {
				private Double moneyValue1 = 1234.56;
				private String moneyMaskedValue1 = String.Empty;

				private String phoneValue1 = "1234567890";
				private String phoneyMaskedValue1 = String.Empty;
			}

			<DemoExample>
				<BuiRow Class="align-items-center mb-3">
					<BuiCol>
						<BuiFormMoney @bind-Value="moneyValue1" @bind-MaskedValue="moneyMaskedValue1" />
					</BuiCol>

					<BuiCol>
						Raw value: @moneyValue1, Masked value: @moneyMaskedValue1
					</BuiCol>
				</BuiRow>

				<BuiRow Class="align-items-center mb-3">
					<BuiCol>
						<BuiFormPhone @bind-Value="phoneValue1" @bind-MaskedValue="phoneyMaskedValue1" />
					</BuiCol>

					<BuiCol>
						Raw value: @phoneValue1, Masked value: @phoneyMaskedValue1
					</BuiCol>
				</BuiRow>

			</DemoExample>
		</BuiCol>
	</BuiRow>
</BuiContainer>